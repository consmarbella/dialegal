# ============================================
# Variables de entorno de LegalHelp (dialegal)
# Coloca tus valores en el panel de Vercel (Settings -> Environment Variables)
# y en un archivo .env local (n-it en git). NUNCA pegues tokens reales aqui.
# ============================================

# Gemini API. Soporta multiples keys separadas por coma (multiplica la cuota).
GEMINI_API_KEY="TU_API_KEY_DE_GEMINI"
# GEMINI_API_KEYS="key1,key2,key3"

# MercadoPago Access Token (produccion: empieza con APP_USR-, sandbox: TEST-)
# Obtenlo en developers.mercadopago.com. Rotalo perioditamente.
MP_ACCESS_TOKEN="TU_TOKEN_DE_MERCADOPAGO"

# URL publica de la app (para back_urls de MercadoPago)
APP_URL="https://legalhelp.cl"

# Capa premium con grounding web oficial en /api/premium-report
PREMIUM_GROUNDING_ENABLED=true

# Correos de notificacion (opcional)
# SMTP_HOST=""
# SMTP_USER=""
# SMTP_PASS=""

# Rate limit general por IP para endpoints caros (por hora, default 30)
GENERAL_API_RATE_LIMIT_MAX=30

# Corpus completo en base de datos (Fase 5). Default: JSON reducidos.
CORPUS_COMPLETO=false

# Base de datos (se configura via Vercel Postgres / Neon; jamas escribir aqui)
# DATABASE_URL="postgresql://..."
# Dibuja/completa data/corpus-full/ con scripts/corpus_ingest_full.py (dataset HF pablobenavidesj/doctrina-jurisprudencia-chile-training). Con CORPUS_COMPLETO=true el motor suma las fichas del area + transversal (2.130 institucionos).
